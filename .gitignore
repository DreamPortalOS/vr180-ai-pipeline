# Jupyter
.ipynb_checkpoints/

# Video experiment artifacts (should not be tracked)
video/*.md
video/*.json
# Mock-provider leakage — double-gate so test/CI artifacts never re-appear
# if the provider's tempdir default is ever regressed (issue #161).
video/mock_*.mp4

# Model weights (too large for git)
models/
!models/.gitkeep
# Depth-product cache (content-keyed; models/.cache/depth/<sha256>/) — issue #182
models/.cache/

# In-repo third-party deps (SeedVR2 node + its dedicated venv — gitignored, never committed)
third_party/

# Config with local paths
.env
*.local.yaml

# Cline private scratch state (NOT the shared CLINE_TASK_BOARD.md)
.cline-state.md
